# @template/.editorconfig

# top-most EditorConfig file.
root = true

# All files.
[*]

# Set default charset to utf-8.
charset = utf-8

# Unix-style newlines with a newline ending every file.
end_of_line = lf
insert_final_newline = true

# Remove trailing whitespace.
trim_trailing_whitespace = true

# Use tab indentation.
indent_style = tab

# Tab width will use the editor default.
tab_width = unset

# Set the line length to 100 characters.
max_line_length = 100


# Specific file formats.

# Markdown.
[**.md]
trim_trailing_whitespace = unset
indent_style = unset

# Fluent.
[*.flt]
indent_size = 2
indent_style = space

# Typescript.
[*.ts]
quote_type = single
indent_brace_style = K&R

# YAML.
[*.{yml,yaml}]
indent_size = 2
indent_style = space

# Licenses.
[LICENSE*]
indent_style = unset

# SQLx.
[.sqlx/**]
max_line_length = unset
indent_style = unset

# Just recipes.
[{justfile, *.just}]
max_line_length = unset

# GitHub Actions.
[.github/workflows/*.yaml]
max_line_length = unset

# OpenTofu / Terraform.
[*.tf]
indent_size = 2
indent_style = space
max_line_length = unset

# D2.
[*.d2]
indent_size = 2
indent_style = space

# Project specific files.
